{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stratus-social",
  "main": "src/stratus.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{"pattern":"stratussocial.mellozone.site","custom_domain":true}],
  "d1_databases": [{"binding":"OAUTH_HANDOFFS","database_name":"stratus-social-oauth-handoffs","database_id":"96fd46c3-3fe7-468b-821b-5bae56d7722f","migrations_dir":"oauth/migrations"}],
  "triggers": {"crons":["*/15 * * * *"]},
  "services": [{"binding":"COLLECTOR","service":"social-poller"}],
  "assets": {"directory":"./stratus-public","binding":"BRAND_ASSETS","run_worker_first":true},
  "ratelimits": [{"name":"STRATUS_READ_LIMIT","namespace_id":"908003","simple":{"limit":60,"period":60}}],
  "observability": {"enabled":true,"head_sampling_rate":0.1,"logs":{"enabled":true,"invocation_logs":false},"traces":{"enabled":false}}
}
